# Copy to .env for local runs. In Kubernetes these come from the chart's
# ConfigMap and Secret instead.

# --- Redis ---
REDIS_NODES=redis://redis1:7070,redis://redis2:7071
REDIS_PASSWORD=devpassword
REDIS_DB=0
REDIS_MAX_CONNECTIONS=200
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_CONNECT_TIMEOUT_SECONDS=2.0

# --- Consistent hashing ---
# Changing this moves keys on the ring and would require a data migration.
VIRTUAL_NODES=100

# --- Write buffer and read cache ---
# A crash loses at most this many seconds of visits.
FLUSH_INTERVAL_SECONDS=30.0
CACHE_TTL_SECONDS=5.0
CACHE_MAX_ENTRIES=10000
SHUTDOWN_FLUSH_TIMEOUT_SECONDS=10.0

# --- Application ---
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Set at image build time.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown

# Comma-separated allow-list. Empty means no browser origin is permitted.
CORS_ALLOW_ORIGINS=
