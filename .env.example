# Copy to .env for local runs. .env is gitignored and excluded from the Docker
# build context. In Kubernetes these come from a ConfigMap, and REDIS_PASSWORD
# from a Secret.

# Redis
REDIS_NODES=redis://redis1:7070,redis://redis2:7071
REDIS_PASSWORD=devpassword
REDIS_DB=0
REDIS_MAX_CONNECTIONS=200
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_CONNECT_TIMEOUT_SECONDS=2.0

# Consistent hashing. Changing this moves every key.
VIRTUAL_NODES=100

# Write buffer and read cache. FLUSH_INTERVAL_SECONDS is also how much
# traffic a crash can lose.
FLUSH_INTERVAL_SECONDS=30.0
SHUTDOWN_FLUSH_TIMEOUT_SECONDS=10.0
CACHE_TTL_SECONDS=5.0
CACHE_MAX_ENTRIES=10000

# Application
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Overwritten at image build time.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown

# Comma-separated. Empty disables CORS entirely.
CORS_ALLOW_ORIGINS=
